# Verge / mihomo profile 模板
# 用法:把 __SUB_URL__ 替换为你的 Mihomo/Clash YAML 订阅链接后,存为 Verge 的 profiles/<uid>.yaml
# Just My Socks 自动化配置 — ZCode 生成于 2026-10-09
# 订阅由 proxy-provider 每 30 分钟自动更新;AUTO 组每 5 分钟自动测速切换最快节点
mode: rule
log-level: info
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://223.5.5.5/dns-query
    - https://120.53.53.53/dns-query

proxy-providers:
  JMS:
    type: http
    url: "__SUB_URL__"
    interval: 1800
    path: ./providers/jms-sub.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 3000

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - AUTO
    use:
      - JMS
  - name: AUTO
    type: url-test
    use:
      - JMS
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

rules:
  - GEOSITE,private,DIRECT
  - GEOSITE,cn,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
