# Verge / mihomo profile 模板
# 用法:把 __SUB_URL__ 替换为你的 Mihomo/Clash YAML 订阅链接后,存为 Verge 的 profiles/<uid>.yaml
# Just My Socks 自动化配置 — ZCode 生成于 2026-10-09
# 订阅由 proxy-provider 每 30 分钟自动更新;AUTO 组每 5 分钟自动测速切换最快节点
mode: rule
log-level: info
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://223.5.5.5/dns-query
    - https://120.53.53.53/dns-query

proxy-providers:
  JMS:
    type: http
    url: "__SUB_URL__"
    interval: 1800
    # 订阅拉取必须直连:默认走本机规则时,订阅会经 PROXY 组出去——全部节点
    # 一旦失联,订阅也拉不到,旧 IP 永不更新,系统无法自愈(2026-11-17 事故)
    proxy: DIRECT
    path: ./providers/jms-sub.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 3000

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - AUTO
    use:
      - JMS
  - name: AUTO
    type: url-test
    use:
      - JMS
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

rules:
  # 指定直连(逐个域名白名单,不做后缀匹配,避免波及同站其他页面)
  # invite.linuxdo.org:Cloudflare 回源对本机全部 6 个 JMS 节点(US/JP/NL)一律 403,
  # 属机房 IP 拦截;只有直连 200。linuxdo.org 主站直连超时,仍需走 PROXY。
  - DOMAIN,invite.linuxdo.org,DIRECT
  - GEOSITE,private,DIRECT
  - GEOSITE,cn,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
